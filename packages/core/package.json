{
  "name": "@coderbabasi/core",
  "version": "0.1.0",
  "description": "UI-free agent loop, tools, and API client for CoderBaba",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderBaba-si/coderbaba.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
